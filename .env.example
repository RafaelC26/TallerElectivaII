# Configuración local. La app carga dos archivos (ninguno se sube al repositorio):
#   1. atlas-credentials.env -> el archivo que genera MongoDB Atlas al crear el cluster
#                               (MONGODB_USERNAME, MONGODB_PASSWORD, MONGODB_URI)
#   2. .env                  -> el resto de variables (copie este archivo como .env)
# Si una variable está en los dos, gana atlas-credentials.env.
# En Vercel no existen estos archivos: configure las variables en Settings > Environment Variables.

# Puerto del servidor local
PORT=3000

# Cadena de conexión de MongoDB Atlas (normalmente ya viene en atlas-credentials.env)
# MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/

# Nombre de la base de datos dentro del cluster
MONGODB_DB=equipos_db

# Secreto para firmar los JWT (mínimo 32 caracteres aleatorios)
# Genérelo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambie-este-valor-por-uno-largo-y-aleatorio

# Tiempo de vida del token (formato de jsonwebtoken: 30m, 2h, 1d...)
JWT_EXPIRES_IN=2h

# Orígenes permitidos por CORS (* = cualquiera, o lista separada por comas)
CORS_ORIGIN=*

# Usuario administrador que crea "npm run seed"
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@equipos.com
ADMIN_PASSWORD=cambie-esta-clave-123
